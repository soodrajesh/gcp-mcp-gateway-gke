# One Google service account per workload that talks to a Google API, bound to its Kubernetes ServiceAccount with
# Workload Identity: no keys exist anywhere. The gateway's identity is how it proves itself to the MCP servers.

locals {
  ns = "mcp-platform"
}

resource "google_service_account" "gateway" {
  project      = var.project_id
  account_id   = "mcp-gateway"
  display_name = "MCP gateway (service-to-service identity)"
  depends_on   = [google_project_service.apis]
}

resource "google_service_account_iam_member" "gateway_wi" {
  service_account_id = google_service_account.gateway.name
  role               = "roles/iam.workloadIdentityUser"
  member             = "serviceAccount:${var.project_id}.svc.id.goog[${local.ns}/mcp-gateway]"
  depends_on         = [google_container_cluster.this]
}

output "gateway_gsa" { value = google_service_account.gateway.email }

# ── finops: reads ONE BigQuery dataset, can run queries (billed to this project) and nothing else ─────────────────────
resource "google_service_account" "finops" {
  project      = var.project_id
  account_id   = "mcp-finops"
  display_name = "MCP finops server (read-only BigQuery)"
  depends_on   = [google_project_service.apis]
}

resource "google_service_account_iam_member" "finops_wi" {
  service_account_id = google_service_account.finops.name
  role               = "roles/iam.workloadIdentityUser"
  member             = "serviceAccount:${var.project_id}.svc.id.goog[${local.ns}/mcp-finops]"
  depends_on         = [google_container_cluster.this]
}

resource "google_bigquery_dataset" "finops" {
  project                    = var.project_id
  dataset_id                 = "mcp_finops"
  location                   = "EU"
  delete_contents_on_destroy = true
  description                = "Synthetic billing data for the MCP finops server (generated by scripts/seed-finops.sh)"
  depends_on                 = [google_project_service.apis]
}

resource "google_bigquery_dataset_iam_member" "finops_viewer" {
  project    = var.project_id
  dataset_id = google_bigquery_dataset.finops.dataset_id
  role       = "roles/bigquery.dataViewer"
  member     = "serviceAccount:${google_service_account.finops.email}"
}

resource "google_project_iam_member" "finops_jobs" {
  project = var.project_id
  role    = "roles/bigquery.jobUser"
  member  = "serviceAccount:${google_service_account.finops.email}"
}

# ── tickets: reads and writes ONE Firestore database ─────────────────────────────────────────────────────────────────
resource "google_service_account" "tickets" {
  project      = var.project_id
  account_id   = "mcp-tickets"
  display_name = "MCP tickets server (Firestore)"
  depends_on   = [google_project_service.apis]
}

resource "google_service_account_iam_member" "tickets_wi" {
  service_account_id = google_service_account.tickets.name
  role               = "roles/iam.workloadIdentityUser"
  member             = "serviceAccount:${var.project_id}.svc.id.goog[${local.ns}/mcp-tickets]"
  depends_on         = [google_container_cluster.this]
}

resource "google_firestore_database" "tickets" {
  project                     = var.project_id
  name                        = "mcp-tickets${var.suffix}"
  location_id                 = var.region
  type                        = "FIRESTORE_NATIVE"
  delete_protection_state     = "DELETE_PROTECTION_DISABLED"
  deletion_policy             = "DELETE"
  app_engine_integration_mode = "DISABLED"
  depends_on                  = [google_project_service.apis]
}

resource "google_project_iam_member" "tickets_datastore" {
  project = var.project_id
  role    = "roles/datastore.user"
  member  = "serviceAccount:${google_service_account.tickets.email}"
  condition {
    title      = "only-the-tickets-database"
    expression = "resource.name == \"projects/${var.project_id}/databases/${google_firestore_database.tickets.name}\""
  }
}

# ── image registry for the three servers (one image, SERVER=k8s|finops|tickets picks the behaviour) ───────────────────
resource "google_artifact_registry_repository" "mcp" {
  project       = var.project_id
  location      = var.region
  repository_id = "mcp"
  format        = "DOCKER"
  description   = "MCP server images"
  depends_on    = [google_project_service.apis]
}

output "finops_gsa" { value = google_service_account.finops.email }
output "tickets_gsa" { value = google_service_account.tickets.email }
output "firestore_database" { value = google_firestore_database.tickets.name }
output "image_repo" { value = "${var.region}-docker.pkg.dev/${var.project_id}/${google_artifact_registry_repository.mcp.repository_id}" }
